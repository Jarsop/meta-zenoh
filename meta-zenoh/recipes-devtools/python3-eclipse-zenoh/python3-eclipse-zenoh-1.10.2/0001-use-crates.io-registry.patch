From 7aa8f1eb84e2743d1d0fe6427791c119b7a97656 Mon Sep 17 00:00:00 2001
From: Jean-Pierre Geslin <jarsop@outlook.com>
Date: Wed, 28 Oct 2026 21:52:48 +0100
Subject: [PATCH 1/2] use crates.io registry

Upstream-Status: Pending
Signed-off-by: Jean-Pierre Geslin <jarsop@outlook.com>
---
 Cargo.toml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index f40a11c..125690b 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -44,10 +44,10 @@ maintenance = { status = "actively-developed" }
 [dependencies]
 paste = "1.0.14"
 pyo3 = { version = "0.25.1", features = ["abi3-py39", "extension-module"] }
-zenoh = { version = "1.10.2", git = "https://github.com/eclipse-zenoh/zenoh.git", branch = "release/1.10.2", features = [
+zenoh = { version = "1.10.2", features = [
   "internal",
   "unstable",
 ], default-features = false }
-zenoh-ext = { version = "1.10.2", git = "https://github.com/eclipse-zenoh/zenoh.git", branch = "release/1.10.2", features = [
+zenoh-ext = { version = "1.10.2", features = [
   "internal",
 ], optional = true }
